{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // BRIDGE front end: the Vite build in dist/ served by Cloudflare Workers static assets
  "name": "encirra",
  "account_id": "78477b5ac310a12d7dbd76555b8be974",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "encirra.bridgeae.com", "custom_domain": true }],
  // one canonical address: the custom domain
  "workers_dev": false,
  "preview_urls": false
}
