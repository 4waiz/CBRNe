# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
.vite/

# Blender backup files
*.blend1
*.blend2

# logs / OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# local tooling
.wrangler/
.playwright/
test-results/

# motion video renders: the final cut is kept, stills and check frames are not
media/release-video/out/*
!media/release-video/out/encirra-qa-release.mp4

# demo video: recorded app footage is regenerated by media/demo-video/capture.mjs
media/demo-video/public/footage/
media/demo-video/out/*
!media/demo-video/out/encirra-demo.mp4
!media/demo-video/out/poster.jpg

# Environment files and secrets: never commit real keys
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
